{
  "family": "ark-fund-demo",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::976193264048:role/ark-fund-demo-execution-role",
  "taskRoleArn": "arn:aws:iam::976193264048:role/ark-fund-demo-task-role",
  "containerDefinitions": [
    {
      "name": "ark-fund-api",
      "image": "976193264048.dkr.ecr.us-east-1.amazonaws.com/ark-fund-api:REPLACE_WITH_COMMIT_SHA",
      "essential": true,
      "portMappings": [{ "containerPort": 8083, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "demo" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "NEW_RELIC_APP_NAME", "value": "ark-fund-demo" },
        { "name": "NEW_RELIC_LOG", "value": "stdout" },
        { "name": "NEW_RELIC_APPLICATION_LOGGING_ENABLED", "value": "true" },
        { "name": "NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED", "value": "true" },
        { "name": "JAVA_TOOL_OPTIONS", "value": "-javaagent:/app/newrelic/newrelic.jar" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:976193264048:secret:ark-fund-api/demo/spring-datasource-url" },
        { "name": "SPRING_DATASOURCE_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:976193264048:secret:ark-fund-api/demo/spring-datasource-username" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:976193264048:secret:ark-fund-api/demo/spring-datasource-password" },
        { "name": "NEW_RELIC_LICENSE_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:976193264048:secret:ark-fund-api/demo/new-relic-license-key" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8083/actuator/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 180
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ark-fund-demo",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
