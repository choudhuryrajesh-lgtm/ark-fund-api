{
  "family": "ark-fund-api-production",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ark-fund-api-execution-role",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ark-fund-api-task-role",
  "containerDefinitions": [
    {
      "name": "ark-fund-api",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/ark-fund-api:REPLACE_WITH_COMMIT_SHA",
      "essential": true,
      "portMappings": [{ "containerPort": 8083, "protocol": "tcp" }],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "production" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ark-fund-api/production/spring-datasource-url" },
        { "name": "SPRING_DATASOURCE_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ark-fund-api/production/spring-datasource-username" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:ark-fund-api/production/spring-datasource-password" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8083/actuator/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ark-fund-api-production",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}